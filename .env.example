# Target deployment environment. This delivery permits only "dev".
TOPX_ENV=dev

# Snowflake account locator, without a URL scheme.
SNOWFLAKE_ACCOUNT=
# Dedicated non-human pipeline service-user login name.
SNOWFLAKE_USER=
# Least-privilege role for discovery, artifact registration, RAW loads, and dbt.
SNOWFLAKE_ROLE=OH_LYME_DEV_PIPELINE_RUNTIME
# Dedicated ingestion/dbt warehouse; it must not be the POC API warehouse.
SNOWFLAKE_WAREHOUSE=OH_LYME_DEV_INGEST_XS_WH
# Isolated governed DEV database. Never set this to ONE_HEALTH_LYME_GAP_ATLAS.
SNOWFLAKE_DATABASE=ONE_HEALTH_LYME_GAP_ATLAS_DEV
# Authentication mode used by the shared Snowflake connection helper.
SNOWFLAKE_AUTH_METHOD=key_pair
# Local path to an encrypted PEM private key. Use locally instead of *_B64.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Passphrase for the encrypted local or base64-encoded private key.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Base64-encoded encrypted private key for App Platform runtime only; never commit it.
SNOWFLAKE_PRIVATE_KEY_B64=

# Required API key for scheduled Data.gov Catalog API v4 discovery.
DATA_GOV_API_KEY=
# Optional/recommended Socrata app token for HealthData.gov, ODN, and CDC requests.
SOCRATA_APP_TOKEN=

# DigitalOcean Spaces region hosting the private immutable artifact bucket.
SPACES_REGION=sfo3
# S3-compatible Spaces endpoint, for example https://sfo3.digitaloceanspaces.com.
SPACES_ENDPOINT=
# Private DEV bucket for raw payloads, source documents, and manifests.
SPACES_BUCKET=one-health-lyme-gap-atlas-data-dev
# Limited-access Spaces key ID; grant access only to the configured DEV bucket.
SPACES_ACCESS_KEY_ID=
# Secret paired with SPACES_ACCESS_KEY_ID; never store it in Git or Snowflake evidence.
SPACES_SECRET_ACCESS_KEY=
# Object-key prefix that keeps DEV artifacts separate from any future production data.
SPACES_PREFIX=dev
