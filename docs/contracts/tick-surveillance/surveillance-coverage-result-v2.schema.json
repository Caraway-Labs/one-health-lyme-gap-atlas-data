{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caraway-labs.github.io/one-health-lyme-gap-atlas-data/contracts/surveillance-coverage-result-v2.schema.json",
  "title": "Internal surveillance coverage safe result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "result_id", "result_revision", "coverage_identity",
    "construct_id", "methodology_version", "calculation_version", "state",
    "reason_codes", "native_grain", "source_scope", "county_fips", "dimension",
    "dimension_label", "site", "event", "source_geography", "county_relationship",
    "representativeness", "temporal_semantics", "date", "period_start", "period_end",
    "tick_species", "publisher_status", "life_stage", "pathogen_name",
    "collection_method", "collection_effort_value", "collection_effort_unit",
    "missingness", "ticks_tested", "ticks_positive", "input_canonical_observation_ids",
    "safe_lineage", "scientific_eligibility", "testing_scope_attestation", "quality",
    "evidence_basis", "publication_status"
  ],
  "properties": {
    "contract_version": {"const": "surveillance-coverage-result-v2"},
    "result_id": {"type": "string", "pattern": "^coverage-result:v2:[0-9a-f]{64}$"},
    "result_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage_identity": {"type": "string", "pattern": "^coverage:v2:[0-9a-f]{64}$"},
    "construct_id": {"enum": ["COUNTY_STATUS_DATASET_REPRESENTATION", "ACTIVE_SITE_EVENT_SAMPLING", "ACTIVE_EFFORT_DOCUMENTATION", "ACTIVE_TESTING_DENOMINATOR_AVAILABILITY"]},
    "methodology_version": {"const": "surveillance-coverage-v1"},
    "calculation_version": {"const": "surveillance-coverage-calculation-v2"},
    "state": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "native_grain": {"enum": ["COUNTY", "SITE_EVENT"]},
    "source_scope": {"type": "object", "required": ["source_family", "publisher", "source_dataset_id", "source_version_id", "source_vintage"]},
    "county_fips": {"type": ["string", "null"], "pattern": "^[0-9]{5}$"},
    "dimension": {"type": ["string", "null"]},
    "dimension_label": {"type": ["string", "null"]},
    "site": {"type": "object"},
    "event": {"type": "object"},
    "source_geography": {"type": "object"},
    "county_relationship": {"type": "object"},
    "representativeness": {"enum": ["COUNTY_NATIVE_STATUS", "NOT_COUNTY_REPRESENTATIVE"]},
    "temporal_semantics": {"enum": ["CUMULATIVE_THROUGH_DATE", "POINT_IN_TIME", "PERIOD"]},
    "date": {"type": ["string", "null"]},
    "period_start": {"type": ["string", "null"]},
    "period_end": {"type": ["string", "null"]},
    "tick_species": {"type": ["string", "null"]},
    "publisher_status": {"type": ["string", "null"]},
    "life_stage": {"type": ["string", "null"]},
    "pathogen_name": {"type": ["string", "null"]},
    "collection_method": {"type": ["string", "null"]},
    "collection_effort_value": {"type": ["number", "null"]},
    "collection_effort_unit": {"type": ["string", "null"]},
    "missingness": {"type": "object"},
    "ticks_tested": {"type": ["integer", "null"]},
    "ticks_positive": {"type": ["integer", "null"]},
    "input_canonical_observation_ids": {"type": "array", "items": {"type": "string"}},
    "safe_lineage": {"type": "array"},
    "scientific_eligibility": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["attestation_version", "field", "semantic_role", "source_dataset_id", "source_version_id", "canonical_id", "normalization_rule_id", "mapping_status", "eligibility"]}},
    "testing_scope_attestation": {"type": ["object", "null"]},
    "source_only_evidence": {"type": "object"},
    "quality": {"type": ["object", "null"]},
    "evidence_basis": {"enum": ["SYNTHETIC_FIXTURE", "CURRENT_CODE_SOURCE_BACKED_REPLAY"]},
    "publication_status": {"const": "INTERNAL_DEV_ONLY"}
  }
}
