{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caraway-labs.github.io/contracts/tick-surveillance/surveillance-quality-profile-v1.schema.json",
  "title": "Surveillance quality profile v1",
  "description": "Additive, component-level analytical quality assessment for one canonical tick-surveillance observation. This is not a composite score, disease-risk estimate, source approval, or release authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_observation_id",
    "source_dataset_id",
    "data_source_version_id",
    "source_record_id",
    "ingestion_run_id",
    "artifact_id",
    "retrieved_at",
    "canonical_method_version",
    "quality_method_version",
    "components"
  ],
  "properties": {
    "canonical_observation_id": {"type": "string", "minLength": 1},
    "source_dataset_id": {"type": "string", "minLength": 1},
    "data_source_version_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "ingestion_run_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "canonical_method_version": {"type": "string", "minLength": 1},
    "quality_method_version": {"const": "surveillance-quality-profile-v1"},
    "components": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "state", "reason_codes"],
        "properties": {
          "dimension": {
            "enum": [
              "TECHNICAL_SOURCE_VALIDITY",
              "PROVENANCE_COMPLETENESS",
              "EFFORT_DENOMINATOR_COMPLETENESS",
              "METHOD_DOCUMENTATION",
              "SPATIAL_REPRESENTATIVENESS",
              "TEMPORAL_COVERAGE_CONTINUITY",
              "TAXONOMIC_LIFE_STAGE_RESOLUTION",
              "PATHOGEN_TESTING_DENOMINATOR_VALIDITY",
              "COMPARABILITY_ELIGIBILITY",
              "FRESHNESS_REVISION_STATE",
              "KNOWN_SOURCE_LIMITATIONS"
            ]
          },
          "state": {"enum": ["ASSESSED", "UNKNOWN", "NOT_APPLICABLE"]},
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
          }
        }
      }
    }
  }
}
