{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caraway-labs.github.io/one-health-lyme-gap-atlas-data/contracts/surveillance-priority-result-v1.schema.json",
  "title": "Internal surveillance evidence review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "methodology_version", "operational_decision", "construct_id",
    "coverage_result_id", "coverage_result_revision", "coverage_identity", "coverage_state",
    "disposition", "comparison_cohort", "comparison_cohort_id", "tie_group_id",
    "display_key", "reason_codes", "source_scope", "native_grain", "temporal_semantics",
    "date", "county_fips", "site", "event", "county_relationship", "representativeness",
    "source_geography", "dimension", "period_start", "period_end", "tick_species",
    "life_stage", "pathogen_name", "collection_method", "collection_effort_unit", "testing_scope",
    "safe_lineage", "quality", "evidence_basis", "interpretation", "publication_status",
    "result_revision", "result_id"
  ],
  "properties": {
    "contract_version": {"const": "surveillance-priority-result-v1"},
    "methodology_version": {"const": "surveillance-priority-v1"},
    "operational_decision": {"const": "SURVEILLANCE_EVIDENCE_REVIEW"},
    "construct_id": {"enum": ["COUNTY_STATUS_DATASET_REPRESENTATION", "ACTIVE_SITE_EVENT_SAMPLING", "ACTIVE_EFFORT_DOCUMENTATION", "ACTIVE_TESTING_DENOMINATOR_AVAILABILITY"]},
    "coverage_result_id": {"type": "string", "minLength": 1},
    "coverage_result_revision": {"type": "string", "minLength": 1},
    "coverage_identity": {"type": "string", "minLength": 1},
    "coverage_state": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["EVIDENCE_GAP_FOLLOW_UP", "EVIDENCE_VERIFICATION", "EXPLANATORY_LIMITATION", "NO_CURRENT_GAP_SIGNAL", "UNAVAILABLE", "NOT_DEFENSIBLE"]},
    "comparison_cohort": {"type": ["object", "null"]},
    "comparison_cohort_id": {"type": ["string", "null"]},
    "tie_group_id": {"type": ["string", "null"]},
    "display_key": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_scope": {"type": "object"},
    "native_grain": {"enum": ["COUNTY", "SITE_EVENT"]},
    "temporal_semantics": {"enum": ["CUMULATIVE_THROUGH_DATE", "POINT_IN_TIME"]},
    "date": {"type": ["string", "null"]},
    "county_fips": {"type": ["string", "null"]},
    "site": {"type": "object"},
    "event": {"type": "object"},
    "county_relationship": {"type": "object"},
    "representativeness": {"enum": ["COUNTY_NATIVE_STATUS", "NOT_COUNTY_REPRESENTATIVE"]},
    "source_geography": {"type": "object"},
    "dimension": {"type": ["string", "null"]},
    "period_start": {"type": ["string", "null"]},
    "period_end": {"type": ["string", "null"]},
    "tick_species": {"type": ["string", "null"]},
    "life_stage": {"type": ["string", "null"]},
    "pathogen_name": {"type": ["string", "null"]},
    "collection_method": {"type": ["string", "null"]},
    "collection_effort_unit": {"type": ["string", "null"]},
    "testing_scope": {"enum": ["INDIVIDUAL_PATHOGEN_TEST", "NOT_APPLICABLE"]},
    "safe_lineage": {"type": "array"},
    "quality": {"type": ["object", "null"]},
    "evidence_basis": {"enum": ["SYNTHETIC_FIXTURE", "CURRENT_CODE_SOURCE_BACKED_REPLAY"]},
    "interpretation": {"type": "string", "minLength": 1},
    "publication_status": {"const": "INTERNAL_DEV_ONLY"},
    "result_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_id": {"type": "string", "pattern": "^surveillance-priority-result:v1:[0-9a-f]{64}$"}
  }
}
