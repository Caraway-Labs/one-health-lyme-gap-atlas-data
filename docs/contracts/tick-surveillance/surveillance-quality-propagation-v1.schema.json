{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caraway-labs.github.io/contracts/tick-surveillance/surveillance-quality-propagation-v1.schema.json",
  "title": "Surveillance quality propagation v1 safe projection",
  "description": "Safe metadata projection for bounded quality propagation; not a scientific metric or quality score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["propagation_schema_version", "transformation_id", "transformation_version", "quality_method_version", "input_canonical_observation_ids", "input_sources", "propagated_components", "inherited_limitations", "transformation_added_reason_codes", "transformation_added_limitations"],
  "properties": {
    "propagation_schema_version": {"const": "surveillance-quality-propagation-v1"},
    "transformation_id": {"type": "string", "minLength": 1},
    "transformation_version": {"type": "string", "minLength": 1},
    "quality_method_version": {"const": "surveillance-quality-profile-v1"},
    "input_canonical_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["canonical_observation_id", "source_dataset_id", "data_source_version_id", "canonical_method_version"], "properties": {"canonical_observation_id": {"type": "string"}, "source_dataset_id": {"type": "string"}, "data_source_version_id": {"type": "string"}, "canonical_method_version": {"type": "string"}}}},
    "propagated_components": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"type": "object", "required": ["dimension", "state", "reason_codes", "input_components"], "properties": {"dimension": {"type": "string"}, "state": {"enum": ["ASSESSED", "UNKNOWN", "NOT_APPLICABLE"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}, "input_components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["canonical_observation_id", "state", "reason_codes"], "properties": {"canonical_observation_id": {"type": "string"}, "state": {"enum": ["ASSESSED", "UNKNOWN", "NOT_APPLICABLE"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}}}}}}},
    "inherited_limitations": {"type": "array", "items": {"type": "string"}},
    "transformation_added_reason_codes": {"type": "array", "items": {"type": "string"}},
    "transformation_added_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
