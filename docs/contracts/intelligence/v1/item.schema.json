{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.carawaylabs.com/intelligence/v1/item.schema.json",
  "title": "item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "item_id",
    "revision_id",
    "source_id",
    "registry_version",
    "canonical_url",
    "title",
    "published_at",
    "updated_at",
    "event_at",
    "excerpt",
    "fetched_at",
    "field_states",
    "geographies",
    "topics",
    "transport",
    "transport_identity_sha256",
    "deduplication_key",
    "content_sha256",
    "provenance",
    "limitations",
    "content_is_untrusted"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "canonical_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[A-Za-z0-9.-]+(?::443)?(?:/[^\\s#]*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^<>\\u0000-\\u001f]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "excerpt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^[^<>\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"
    },
    "field_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_url",
        "title",
        "published_at",
        "updated_at",
        "event_at",
        "excerpt"
      ],
      "properties": {
        "canonical_url": {
          "enum": [
            "present",
            "not_provided",
            "withheld",
            "invalid"
          ]
        },
        "title": {
          "enum": [
            "present",
            "not_provided",
            "withheld",
            "invalid"
          ]
        },
        "published_at": {
          "enum": [
            "present",
            "not_provided",
            "withheld",
            "invalid"
          ]
        },
        "updated_at": {
          "enum": [
            "present",
            "not_provided",
            "withheld",
            "invalid"
          ]
        },
        "event_at": {
          "enum": [
            "present",
            "not_provided",
            "withheld",
            "invalid"
          ]
        },
        "excerpt": {
          "enum": [
            "present",
            "not_provided",
            "withheld",
            "invalid"
          ]
        }
      }
    },
    "geographies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "origin",
          "method",
          "method_version",
          "confidence"
        ],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
          },
          "origin": {
            "enum": [
              "publisher",
              "inferred"
            ]
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "method_version": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "inferred"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
                },
                "method_version": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "publisher"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "type": "null"
                },
                "method_version": {
                  "type": "null"
                },
                "confidence": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "origin",
          "method",
          "method_version",
          "confidence"
        ],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
          },
          "origin": {
            "enum": [
              "publisher",
              "inferred"
            ]
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "method_version": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "inferred"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
                },
                "method_version": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "publisher"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "type": "null"
                },
                "method_version": {
                  "type": "null"
                },
                "confidence": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "transport": {
      "enum": [
        "rss",
        "atom",
        "email",
        "web"
      ]
    },
    "transport_identity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deduplication_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "artifact_id",
        "artifact_sha256",
        "parser_version",
        "fetch_version",
        "normalization_version"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parser_version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
        },
        "fetch_version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
        },
        "normalization_version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "content_is_untrusted": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "field_states": {
            "properties": {
              "canonical_url": {
                "const": "present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "canonical_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[A-Za-z0-9.-]+(?::443)?(?:/[^\\s#]*)?$"
          }
        }
      },
      "else": {
        "properties": {
          "canonical_url": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "field_states": {
            "properties": {
              "title": {
                "const": "present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^[^<>\\u0000-\\u001f]*$"
          }
        }
      },
      "else": {
        "properties": {
          "title": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "field_states": {
            "properties": {
              "published_at": {
                "const": "present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "published_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"
          }
        }
      },
      "else": {
        "properties": {
          "published_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "field_states": {
            "properties": {
              "updated_at": {
                "const": "present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"
          }
        }
      },
      "else": {
        "properties": {
          "updated_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "field_states": {
            "properties": {
              "event_at": {
                "const": "present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "event_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"
          }
        }
      },
      "else": {
        "properties": {
          "event_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "field_states": {
            "properties": {
              "excerpt": {
                "const": "present"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "^[^<>\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
          }
        }
      },
      "else": {
        "properties": {
          "excerpt": {
            "type": "null"
          }
        }
      }
    }
  ]
}
