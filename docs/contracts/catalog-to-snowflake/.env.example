# TOPx catalog-to-Snowflake pipeline configuration template.
# Copy this file to .env for local development. Keep .env out of Git.
# Leave this template's values blank; never commit real secrets.

# -----------------------------------------------------------------------------
# Catalog discovery
# -----------------------------------------------------------------------------

# Required for scheduled Data.gov Catalog API v4 discovery.
DATA_GOV_API_KEY=

# Recommended for Socrata / HealthData.gov / ODN discovery and source queries.
SOCRATA_APP_TOKEN=

# -----------------------------------------------------------------------------
# Snowflake connection: local development
# -----------------------------------------------------------------------------

# Snowflake account locator, without a URL scheme.
SNOWFLAKE_ACCOUNT=

# Dedicated non-human pipeline service-user login name.
SNOWFLAKE_USER=

# Least-privilege role used by the pipeline service user.
SNOWFLAKE_ROLE=

# Dedicated ingestion/dbt warehouse, for example OH_LYME_INGEST_XS_WH.
SNOWFLAKE_WAREHOUSE=

# Target environment database: ONE_HEALTH_LYME_GAP_ATLAS_DEV locally; ONE_HEALTH_LYME_GAP_ATLAS_PROD only in production.
SNOWFLAKE_DATABASE=ONE_HEALTH_LYME_GAP_ATLAS_DEV

# Path to the encrypted private-key file on your local machine.
# Do not place private-key bytes directly in this file.
SNOWFLAKE_PRIVATE_KEY_PATH=

# Passphrase for the encrypted local private key.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# -----------------------------------------------------------------------------
# Snowflake connection: DigitalOcean App Platform production runtime
# -----------------------------------------------------------------------------

# Base64-encoded encrypted private-key contents.
# Configure this as an encrypted runtime secret in DigitalOcean App Platform.
# It is not needed in a normal local .env file when SNOWFLAKE_PRIVATE_KEY_PATH is used.
SNOWFLAKE_PRIVATE_KEY_B64=

# -----------------------------------------------------------------------------
# DigitalOcean Spaces: private immutable artifact storage
# -----------------------------------------------------------------------------

# DigitalOcean region containing the private Space, for example nyc3.
SPACES_REGION=

# S3-compatible endpoint, for example https://nyc3.digitaloceanspaces.com.
SPACES_ENDPOINT=

# Private bucket/Space name. Use a DEV bucket or prefix locally.
SPACES_BUCKET=

# Limited-access Spaces key ID with only the required bucket permissions.
SPACES_ACCESS_KEY_ID=

# Secret for the limited-access Spaces key.
SPACES_SECRET_ACCESS_KEY=

# Optional object-key prefix. Suggested values: dev or prod.
SPACES_PREFIX=dev

# -----------------------------------------------------------------------------
# Application behavior
# -----------------------------------------------------------------------------

# One of: dev, prod. Must agree with SNOWFLAKE_DATABASE and SPACES_PREFIX.
TOPX_ENV=dev

# JSON catalog-search configuration path relative to the repository root.
CATALOG_SEARCH_TERMS_PATH=catalog-search-terms.json

# Structured log level. Do not use DEBUG in production if it could expose data.
LOG_LEVEL=INFO
